        "id": "9278b44b-fe7a-4ba0-ba32-843f8c297985",
        "name": "Construire l'email"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH envoi AS (\n  INSERT INTO sent_newsletters (user_id, article_ids)\n  VALUES ($1::uuid, ARRAY(SELECT json_array_elements_text($2::json)::bigint))\n)\nUPDATE preferences\nSET last_sent_at = now()\nWHERE user_id = $1::uuid;",
          "options": {
            "queryReplacement": "={{ [ $('Utilisateurs à servir').item.json.id, JSON.stringify($('A des articles').item.json.articles.map(a => a.id)) ] }}"
          }
        },
