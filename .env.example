# Modèle du fichier .env. Ne JAMAIS commit le .env.
# bash scripts/setup.sh crée le .env tout seul la première fois, avec des mots de passe générés :
# il n'y a rien à remplir, sauf la clé Gemini si on en a une.

# Compte administrateur de PostgreSQL
POSTGRES_USER=persona_admin
POSTGRES_PASSWORD=change-moi-admin
# Mot de passe du compte limité utilisé par n8n pour accéder aux données Persona
PERSONA_DB_PASSWORD=change-moi-app
# Chiffre les credentials dans n8n. Ne plus la changer après le premier lancement :
# n8n ne pourrait plus lire les credentials déjà enregistrés.
# Générer avec : openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-moi

# Clé API Gemini, gratuite sur https://aistudio.google.com/apikey
# Sans clé : l'inscription et la connexion marchent, mais pas l'agent ni la collecte des news.
GEMINI_API_KEY=
