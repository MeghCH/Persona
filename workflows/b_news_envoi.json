        "id": "a1bb6b34-a7ce-43c4-a615-0c7a41754a02",
        "name": "Schedule Trigger"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT u.id, u.email, u.unsubscribe_token, p.interests, p.max_articles\nFROM users u\nJOIN preferences p ON p.user_id = u.id\nWHERE p.is_active\n  AND p.send_hour = EXTRACT(HOUR FROM now() AT TIME ZONE p.timezone)\n  AND EXTRACT(ISODOW FROM now() AT TIME ZONE p.timezone) = ANY (p.send_days)\n  AND (p.last_sent_at IS NULL OR p.last_sent_at < now() - INTERVAL '20 hours');",
          "options": {}
        },
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [
          224,
          0
        ],
        "id": "73a6e7d8-d2bd-44e4-81a9-4986ebb49ca3",
        "name": "Utilisateurs à servir",
        "credentials": {
          "postgres": {
            "id": "NVYHYZPCSYpCPKph",
            "name": "postgres (à configurer)"
          }
        }
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT COALESCE(json_agg(x), '[]') AS articles\nFROM (\n  SELECT id, title, url, source, summary\n  FROM articles\n  WHERE tags && ARRAY(SELECT json_array_elements_text($1::json))\n    AND summary IS NOT NULL\n    AND fetched_at > now() - INTERVAL '24 hours'\n  ORDER BY published_at DESC NULLS LAST\n  LIMIT 5\n) x;",
          "options": {
            "queryReplacement": "={{ [ JSON.stringify($json.interests) ] }}"
          }
        },
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [
          448,
          0
        ],
        "id": "58946305-1c9c-49d4-b121-503bb0d55d06",
        "name": "Articles pour l'utilisateur",
        "credentials": {
          "postgres": {
            "id": "NVYHYZPCSYpCPKph",
            "name": "postgres (à configurer)"
          }
        }
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 4
            },
            "conditions": [
              {
                "id": "9f8f883f-fad6-42fc-922c-74fccbea3236",
                "leftValue": "={{ $json.articles.length }}",
                "rightValue": 0,
                "operator": {
                  "type": "number",
                  "operation": "gt"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "type": "n8n-nodes-base.filter",
        "typeVersion": 2.4,
