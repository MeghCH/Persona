      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(x), '[]') AS articles\nFROM (\n  SELECT id, title, url, source, summary\n  FROM articles\n  WHERE tags && ARRAY(SELECT json_array_elements_text($1::json))\n    AND summary IS NOT NULL\n    AND fetched_at > now() - INTERVAL '24 hours'\n  ORDER BY published_at DESC NULLS LAST\n  LIMIT $2::int\n) x;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json.interests), $json.max_articles ] }}"
        }
