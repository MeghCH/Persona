                "value": "={{ $json.articles.map(a => `<p><a href=\"${a.url}\"><b>${a.title}</b></a><br><small>${a.source}</small><br>${a.summary}</p>`).join('') }}",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
