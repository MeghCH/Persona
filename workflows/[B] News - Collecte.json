    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { source: 'Le Monde',    url: 'https://www.lemonde.fr/rss/une.xml' } },\n  { json: { source: 'France Info', url: 'https://www.francetvinfo.fr/titres.rss' } },\n  { json: { source: 'Numerama',    url: 'https://www.numerama.com/feed/' } },\n  { json: { source: 'BBC News',    url: 'https://feeds.bbci.co.uk/news/rss.xml' } },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
