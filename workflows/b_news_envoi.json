    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Le titre vient du flux RSS et le résumé de l'IA : on les échappe avant de les\n// mettre dans le HTML, et on écarte les articles sans lien http(s) ou sans résumé.\nconst echapper = s => String(s ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst lienValide = url => typeof url === 'string' && /^https?:\\/\\/[^\\s\"'<>]+$/i.test(url);\n\nconst articles = ($json.articles || []).filter(a =>\n  lienValide(a.url) && a.title && typeof a.summary === 'string' && a.summary.trim());\n\nconst blocs = articles.map(a =>\n  `<p><a href=\"${echapper(a.url)}\"><b>${echapper(a.title)}</b></a><br>` +\n  `<small>${echapper(a.source)}</small><br>${echapper(a.summary)}</p>`\n).join('');\n\nreturn { json: { articles, blocs } };"
      },
