                "value": "=Ta revue de presse Persona du {{ $now.setZone('Europe/Paris').setLocale('fr').toFormat('d LLLL') }}",
                "type": "string"
              },
              {
                "id": "0ca73bd5-8bbb-445d-976a-82137d01334a",
                "name": "html",
                "value": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:auto\">   <h1 style=\"color:#1a56db\">Ta revue de presse Persona</h1>    {{ $json.blocs }}    <hr>   <p style=\"font-size:12px;color:#6b7280\">     Tu reçois cet email car tu t'es inscrit à Persona.     <a href=\"http://localhost:5678/webhook/unsubscribe?token={{ $('Utilisateurs à servir').item.json.unsubscribe_token }}\">Se désinscrire</a>   </p> </div>",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.5,
        "position": [
