    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH envoi AS (\n  INSERT INTO sent_newsletters (user_id, article_ids)\n  VALUES ($1::uuid, ARRAY(SELECT json_array_elements_text($2::json)::bigint))\n)\nUPDATE preferences\nSET last_sent_at = now()\nWHERE user_id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $('Utilisateurs à servir').item.json.id, JSON.stringify($('Préparer les articles').item.json.articles.map(a => a.id)) ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        2016,
        -96
      ],
      "id": "10d78ca3-816c-4e88-b13b-c6c6bff03ed6",
      "name": "Enregistrer l'envoi",
      "credentials": {
        "postgres": {
          "id": "NVYHYZPCSYpCPKph",
          "name": "Postgres Persona"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Dernier contrôle avant l'envoi : si un point échoue, l'email n'est pas envoyé\n// et le blocage est noté dans audit_log.\nconst { to, subject, html } = $json;\nconst nbArticles = $('Préparer les articles').item.json.articles.length;\nconst token = String($('Utilisateurs à servir').item.json.unsubscribe_token ?? '');\nconst problemes = [];\n\nif (!/^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}$/.test(to || ''))\n  problemes.push('destinataire invalide');\nif (!subject || /[\\r\\n]/.test(subject)) problemes.push('sujet invalide');\nif (nbArticles === 0) problemes.push('aucun article');\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(token)\n    || !html.includes(`/webhook/unsubscribe?token=${token}\"`))\n  problemes.push('lien de désinscription absent');  // obligatoire (RGPD)\n// le texte est échappé : un vrai « < » ne peut venir que du modèle de l'email\nif (/<\\s*(script|iframe|object|embed|form|style|img|svg)\\b|<[^>]*\\son[a-z]+\\s*=/i.test(html))\n  problemes.push('HTML dangereux');\nif ([...html.matchAll(/href=\"([^\"]*)\"/g)].some(m => !/^https?:\\/\\//i.test(m[1])))\n  problemes.push('lien non http(s)');\nif (html.length > 100000) problemes.push('email trop lourd');\n\nreturn { json: { to, subject, html, valide: problemes.length === 0, problemes, nb_articles: nbArticles } };"
      },
